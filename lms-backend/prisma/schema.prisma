generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int              @id @default(autoincrement())
  name           String
  email          String           @unique
  password       String
  createdAt      DateTime         @default(now())
  emailVerified  Boolean          @default(false)
  updatedAt      DateTime         @updatedAt
  role           UserRole         @default(STUDENT)
  expertise      String?
  bio            String?
  social_links   String?
  profileImage   String?
  certificates   Certificate[]
  coursesCreated Course[]         @relation("CourseCreator")
  enrollments    Enrollment[]
  lessonProgress LessonProgress[]
  notifications  Notification[]
  payments       Payment[]
  reviews        Review[]
}

model PendingUser {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model OTP {
  id        Int        @id @default(autoincrement())
  email     String
  otp       String
  purpose   OTPPurpose
  expiresAt DateTime
  createdAt DateTime   @default(now())

  @@index([email, purpose])
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  slug        String   @unique
  description String?
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  courses     Course[]
}

model Course {
  id                  Int                  @id @default(autoincrement())
  title               String
  slug                String               @unique
  subtitle            String?
  description         String?
  thumbnail           String?
  trailer             String?
  price               Float
  discountPrice       Float?
  duration            Int
  level               String
  language            String
  categoryId          Int
  createdById         Int
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  audience            String?
  isFeatured          Boolean              @default(false)
  isPublished         Boolean              @default(false)
  outcomes            String?
  requirements        String?
  status              CourseStatus         @default(DRAFT)
  certificates        Certificate[]
  certificateTemplate CertificateTemplate?
  category            Category             @relation(fields: [categoryId], references: [id])
  createdBy           User                 @relation("CourseCreator", fields: [createdById], references: [id])
  modules             CourseModule[]
  enrollments         Enrollment[]
  payments            Payment[]
  reviews             Review[]
}

model CourseModule {
  id          Int      @id @default(autoincrement())
  title       String
  position    Int
  courseId    Int
  createdAt   DateTime @default(now())
  description String?
  updatedAt   DateTime @updatedAt
  course      Course   @relation(fields: [courseId], references: [id])
  lessons     Lesson[]
}

model Lesson {
  id          Int              @id @default(autoincrement())
  title       String
  description String?
  videoUrl    String?
  duration    Int
  position    Int
  moduleId    Int
  attachment  String?
  createdAt   DateTime         @default(now())
  isPreview   Boolean          @default(false)
  updatedAt   DateTime         @updatedAt
  videoType   String
  module      CourseModule     @relation(fields: [moduleId], references: [id])
  progress    LessonProgress[]
}

model Enrollment {
  id            Int          @id @default(autoincrement())
  userId        Int
  courseId      Int
  progress      Float        @default(0)
  completed     Boolean      @default(false)
  enrolledAt    DateTime     @default(now())
  certificateId Int?         @unique
  certificateNo String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  certificate   Certificate? @relation(fields: [certificateId], references: [id])
  course        Course       @relation(fields: [courseId], references: [id])
  user          User         @relation(fields: [userId], references: [id])

  @@unique([userId, courseId])
}

model Review {
  id        Int       @id @default(autoincrement())
  rating    Int
  comment   String?
  createdAt DateTime  @default(now())
  userId    Int
  courseId  Int
  isRead    Boolean   @default(false)
  repliedAt DateTime?
  reply     String?
  updatedAt DateTime  @default(now())
  course    Course    @relation(fields: [courseId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
}

model LessonProgress {
  id        Int       @id @default(autoincrement())
  studentId Int
  lessonId  Int
  completed Boolean   @default(false)
  watchedAt DateTime?
  createdAt DateTime  @default(now())
  lesson    Lesson    @relation(fields: [lessonId], references: [id])
  student   User      @relation(fields: [studentId], references: [id])

  @@unique([studentId, lessonId])
}

model Payment {
  id        Int      @id @default(autoincrement())
  orderId   String   @unique
  paymentId String?  @unique
  signature String?
  studentId Int
  courseId  Int
  amount    Float
  currency  String   @default("INR")
  status    String   @default("PENDING")
  method    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course    Course   @relation(fields: [courseId], references: [id])
  student   User     @relation(fields: [studentId], references: [id])
}

model Notification {
  id        Int      @id @default(autoincrement())
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  studentId Int
  createdAt DateTime @default(now())
  student   User     @relation(fields: [studentId], references: [id])
}

model Certificate {
  id             Int         @id @default(autoincrement())
  certificateNo  String      @unique
  studentId      Int
  courseId       Int
  pdfUrl         String?
  courseTitle    String
  createdAt      DateTime    @default(now())
  instructorName String
  issueDate      DateTime
  qrCodeUrl      String?
  revokeReason   String?
  revokedAt      DateTime?
  status         String      @default("PENDING")
  studentName    String
  updatedAt      DateTime    @updatedAt
  course         Course      @relation(fields: [courseId], references: [id])
  student        User        @relation(fields: [studentId], references: [id])
  Enrollment     Enrollment?
}

model CertificateTemplate {
  id              Int      @id @default(autoincrement())
  courseId        Int      @unique
  header          String   @default("Certificate of Completion")
  footer          String   @default("Issued by ZSmartClass")
  textColor       String   @default("#1a1a2e")
  backgroundColor String   @default("#ffffff")
  borderColor     String   @default("#667eea")
  fontFamily      String   @default("Helvetica")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  course          Course   @relation(fields: [courseId], references: [id])
}

model Settings {
  id        Int      @id @default(1)
  data      Json
  updatedAt DateTime @updatedAt
}

enum UserRole {
  ADMIN
  MENTOR
  STUDENT
}

enum OTPPurpose {
  REGISTER
  PASSWORD_RESET
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

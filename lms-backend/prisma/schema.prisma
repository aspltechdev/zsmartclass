generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MENTOR
  STUDENT
}

enum OTPPurpose {
  REGISTER
  PASSWORD_RESET
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id            Int      @id @default(autoincrement())
  name          String
  email         String   @unique
  password      String
  role          UserRole @default(STUDENT)
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  coursesCreated Course[]         @relation("CourseCreator")
  enrollments    Enrollment[]
  lessonProgress LessonProgress[]
  payments       Payment[]
  notifications  Notification[]
  reviews        Review[]
  certificates   Certificate[]
}

model PendingUser {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model OTP {
  id        Int        @id @default(autoincrement())
  email     String
  otp       String
  purpose   OTPPurpose
  expiresAt DateTime
  createdAt DateTime   @default(now())

  @@index([email, purpose])
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  slug        String   @unique
  description String?
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  courses     Course[]
}

model Course {
  id            Int          @id @default(autoincrement())
  title         String
  slug          String       @unique
  subtitle      String?
  description   String?      @db.Text
  thumbnail     String?
  trailer       String?
  language      String
  level         String
  duration      Int
  price         Float
  discountPrice Float?
  requirements  String?      @db.Text
  outcomes      String?      @db.Text
  audience      String?      @db.Text
  status        CourseStatus @default(DRAFT)
  isFeatured    Boolean      @default(false)
  isPublished   Boolean      @default(false)
  categoryId    Int
  createdById   Int
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  category            Category             @relation(fields: [categoryId], references: [id])
  createdBy           User                 @relation("CourseCreator", fields: [createdById], references: [id])
  modules             CourseModule[]
  enrollments         Enrollment[]
  payments            Payment[]
  reviews             Review[]
  certificates        Certificate[]
  certificateTemplate CertificateTemplate?
}

model CourseModule {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  position    Int
  courseId    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id])
  lessons Lesson[]
}

model Lesson {
  id          Int      @id @default(autoincrement())
  title       String
  description String?  @db.Text
  videoType   String
  videoUrl    String?
  attachment  String?
  duration    Int
  position    Int
  isPreview   Boolean  @default(false)
  moduleId    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  module   CourseModule     @relation(fields: [moduleId], references: [id])
  progress LessonProgress[]
}

model Enrollment {
  id            Int      @id @default(autoincrement())
  userId        Int
  courseId      Int
  progress      Float    @default(0)
  completed     Boolean  @default(false)
  enrolledAt    DateTime @default(now())
  certificateId Int?     @unique
  certificateNo String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id])
  course      Course       @relation(fields: [courseId], references: [id])
  certificate Certificate? @relation(fields: [certificateId], references: [id])

  @@unique([userId, courseId])
}

model Review {
  id        Int      @id @default(autoincrement())
  rating    Int
  comment   String?  @db.Text
  userId    Int
  courseId  Int
  isRead    Boolean  @default(false)
  reply     String?  @db.Text
  repliedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt  // This is the problematic field

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])
}

model LessonProgress {
  id        Int       @id @default(autoincrement())
  studentId Int
  lessonId  Int
  completed Boolean   @default(false)
  watchedAt DateTime?
  createdAt DateTime  @default(now())

  student User   @relation(fields: [studentId], references: [id])
  lesson  Lesson @relation(fields: [lessonId], references: [id])

  @@unique([studentId, lessonId])
}

model Payment {
  id        Int      @id @default(autoincrement())
  orderId   String   @unique
  paymentId String?  @unique
  signature String?
  studentId Int
  courseId  Int
  amount    Float
  currency  String   @default("INR")
  status    String   @default("PENDING")
  method    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student User   @relation(fields: [studentId], references: [id])
  course  Course @relation(fields: [courseId], references: [id])
}

model Notification {
  id        Int      @id @default(autoincrement())
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  studentId Int
  createdAt DateTime @default(now())

  student User @relation(fields: [studentId], references: [id])
}

model Certificate {
  id             Int       @id @default(autoincrement())
  certificateNo  String    @unique
  studentId      Int
  courseId       Int
  studentName    String
  courseTitle    String
  instructorName String
  issueDate      DateTime
  status         String    @default("PENDING")
  qrCodeUrl      String?
  pdfUrl         String?
  revokedAt      DateTime?
  revokeReason   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  student    User        @relation(fields: [studentId], references: [id])
  course     Course      @relation(fields: [courseId], references: [id])
  // Remove the enrollment relation from here - it's defined on Enrollment side
  Enrollment Enrollment?
}

model CertificateTemplate {
  id              Int      @id @default(autoincrement())
  courseId        Int      @unique
  header          String   @default("Certificate of Completion")
  footer          String   @default("Issued by ZSmartClass")
  textColor       String   @default("#1a1a2e")
  backgroundColor String   @default("#ffffff")
  borderColor     String   @default("#667eea")
  fontFamily      String   @default("Helvetica")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id])
}

model Settings {
  id        Int      @id @default(1)
  data      Json
  updatedAt DateTime @updatedAt
}
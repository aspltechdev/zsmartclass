generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   Int                    @id @default(autoincrement())
  name                 String
  email                String                 @unique
  password             String?
  createdAt            DateTime               @default(now())
  emailVerified        Boolean                @default(false)
  updatedAt            DateTime               @updatedAt
  role                 UserRole               @default(STUDENT)
  expertise            String?
  bio                  String?
  social_links         String?
  profileImage         String?
  isActive             Boolean?               @default(false)
  invitationToken      String?                @unique
  invitationExpiry     DateTime?              @db.Timestamp(6)
  invitedBy            Int?
  Assignment           Assignment[]
  AssignmentSubmission AssignmentSubmission[]
  certificates         Certificate[]
  coursesCreated       Course[]               @relation("CourseCreator")
  enrollments          Enrollment[]
  lessonProgress       LessonProgress[]
  notifications        Notification[]
  payments             Payment[]
  reviews              Review[]
  User                 User?                  @relation("UserToUser", fields: [invitedBy], references: [id], onUpdate: NoAction)
  other_User           User[]                 @relation("UserToUser")

  @@index([email], map: "idx_user_email")
  @@index([isActive], map: "idx_user_isActive")
  @@index([role], map: "idx_user_role")
}

model PendingUser {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model OTP {
  id        Int        @id @default(autoincrement())
  email     String
  otp       String
  purpose   OTPPurpose
  expiresAt DateTime
  createdAt DateTime   @default(now())

  @@index([email, purpose])
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  slug        String   @unique
  description String?
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  courses     Course[]
}

model Course {
  id                  Int                  @id @default(autoincrement())
  title               String
  slug                String               @unique
  subtitle            String?
  description         String?
  thumbnail           String?
  trailer             String?
  price               Float
  discountPrice       Float?
  duration            Int
  level               String
  language            String
  categoryId          Int
  createdById         Int
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  audience            String?
  isFeatured          Boolean              @default(false)
  isPublished         Boolean              @default(false)
  outcomes            String?
  requirements        String?
  status              CourseStatus         @default(DRAFT)
  Assignment          Assignment[]
  certificates        Certificate[]
  certificateTemplate CertificateTemplate?
  category            Category             @relation(fields: [categoryId], references: [id])
  createdBy           User                 @relation("CourseCreator", fields: [createdById], references: [id])
  modules             CourseModule[]
  enrollments         Enrollment[]
  payments            Payment[]
  reviews             Review[]
}

model CourseModule {
  id          Int      @id @default(autoincrement())
  title       String
  position    Int
  courseId    Int?
  createdAt   DateTime @default(now())
  description String?
  updatedAt   DateTime @updatedAt
  isShared    Boolean? @default(false)
  moduleSlug  String?  @unique
  isPublished Boolean? @default(true)
  thumbnail   String?
  category    String?
  tags        String[] @default([])
  course      Course?  @relation(fields: [courseId], references: [id], onUpdate: NoAction)
  lessons     Lesson[]

  @@index([isShared], map: "idx_coursemodule_isShared")
  @@index([moduleSlug], map: "idx_coursemodule_moduleSlug")
}

model Lesson {
  id          Int              @id @default(autoincrement())
  title       String
  description String?
  videoUrl    String?
  position    Int              @default(0)
  moduleId    Int
  attachment  String?
  createdAt   DateTime         @default(now())
  isPreview   Boolean          @default(false)
  updatedAt   DateTime         @updatedAt
  videoType   String           @default("VIDEO")
  lessonSlug  String?          @unique
  isShared    Boolean?         @default(false)
  module      CourseModule     @relation(fields: [moduleId], references: [id])
  progress    LessonProgress[]

  @@index([isShared], map: "idx_lesson_isShared")
  @@index([lessonSlug], map: "idx_lesson_lessonSlug")
}

model Enrollment {
  id             Int          @id @default(autoincrement())
  userId         Int
  courseId       Int
  progress       Float        @default(0)
  completed      Boolean      @default(false)
  enrolledAt     DateTime     @default(now())
  certificateId  Int?         @unique
  certificateNo  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  accessExpiry   DateTime?    @db.Timestamp(6)
  accessDuration Int?
  isExpired      Boolean?     @default(false)
  certificate    Certificate? @relation(fields: [certificateId], references: [id])
  course         Course       @relation(fields: [courseId], references: [id])
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, courseId])
  @@index([accessExpiry], map: "idx_enrollment_accessExpiry")
  @@index([courseId], map: "idx_enrollment_courseId")
  @@index([isExpired], map: "idx_enrollment_isExpired")
  @@index([userId], map: "idx_enrollment_userId")
}

model Review {
  id        Int       @id @default(autoincrement())
  rating    Int
  comment   String?
  createdAt DateTime  @default(now())
  userId    Int
  courseId  Int
  isRead    Boolean   @default(false)
  repliedAt DateTime?
  reply     String?
  updatedAt DateTime  @default(now())
  course    Course    @relation(fields: [courseId], references: [id])
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model LessonProgress {
  id             Int       @id @default(autoincrement())
  studentId      Int
  lessonId       Int
  completed      Boolean   @default(false)
  watchedAt      DateTime?
  createdAt      DateTime  @default(now())
  watchedSeconds Int       @default(0)
  lesson         Lesson    @relation(fields: [lessonId], references: [id])
  student        User      @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([studentId, lessonId])
}

model Payment {
  id        Int      @id @default(autoincrement())
  orderId   String   @unique
  paymentId String?  @unique
  signature String?
  studentId Int
  courseId  Int
  amount    Float
  currency  String   @default("INR")
  status    String   @default("PENDING")
  method    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course    Course   @relation(fields: [courseId], references: [id])
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Notification {
  id        Int      @id @default(autoincrement())
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  studentId Int
  createdAt DateTime @default(now())
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Certificate {
  id             Int         @id @default(autoincrement())
  certificateNo  String      @unique
  studentId      Int
  courseId       Int
  pdfUrl         String?
  courseTitle    String
  createdAt      DateTime    @default(now())
  instructorName String
  issueDate      DateTime
  qrCodeUrl      String?
  revokeReason   String?
  revokedAt      DateTime?
  status         String      @default("PENDING")
  studentName    String
  updatedAt      DateTime    @updatedAt
  course         Course      @relation(fields: [courseId], references: [id])
  student        User        @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Enrollment     Enrollment?
}

model CertificateTemplate {
  id              Int      @id @default(autoincrement())
  courseId        Int      @unique
  header          String   @default("Certificate of Completion")
  footer          String   @default("Issued by ZSmartClass")
  textColor       String   @default("#1a1a2e")
  backgroundColor String   @default("#ffffff")
  borderColor     String   @default("#667eea")
  fontFamily      String   @default("Helvetica")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  course          Course   @relation(fields: [courseId], references: [id])
}

model Settings {
  id        Int      @id @default(1)
  data      Json
  updatedAt DateTime @updatedAt
}

model Assignment {
  id                   Int                    @id @default(autoincrement())
  title                String
  description          String
  dueDate              DateTime
  totalMarks           Int
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  courseId             Int
  mentorId             Int
  Course               Course                 @relation(fields: [courseId], references: [id])
  User                 User                   @relation(fields: [mentorId], references: [id])
  AssignmentSubmission AssignmentSubmission[]
}

model AssignmentSubmission {
  id             Int        @id @default(autoincrement())
  assignmentId   Int
  studentId      Int
  submissionText String?
  attachment     String?
  marks          Float?
  feedback       String?
  status         String     @default("PENDING")
  submittedAt    DateTime   @default(now())
  Assignment     Assignment @relation(fields: [assignmentId], references: [id])
  User           User       @relation(fields: [studentId], references: [id])
}

enum UserRole {
  ADMIN
  MENTOR
  STUDENT
}

enum OTPPurpose {
  REGISTER
  PASSWORD_RESET
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
